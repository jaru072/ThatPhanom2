// สำหรับ Firebase Console → Firestore Database → Rules เท่านั้น
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isDefaultAdmin() {
      return signedIn()
        && 'email' in request.auth.token
        && request.auth.token.email != null
        && (request.auth.token.email == 'jaru072@gmail.com'
            || request.auth.token.email.matches('(?i)^jaru072@gmail[.]com$'));
    }

    function isGlobalAdmin() {
      return isDefaultAdmin()
        || (signedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('globalRole', '') == 'admin');
    }

    function projectRole(projectId) {
      return isGlobalAdmin() ? 'admin'
        : (signedIn() && exists(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)))
          ? get(/databases/$(database)/documents/projects/$(projectId)/members/$(request.auth.uid)).data.get('role', 'guest')
          : 'guest';
    }

    function isAdmin(projectId) {
      return isGlobalAdmin() || projectRole(projectId) == 'admin';
    }

    function isStaff(projectId) {
      return projectRole(projectId) in ['admin', 'manager'];
    }

    match /users/{userId} {
      allow get: if signedIn() && (request.auth.uid == userId || isGlobalAdmin());
      allow list: if isGlobalAdmin();
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.globalRole == (isDefaultAdmin() ? 'admin' : 'user');
      allow update: if isGlobalAdmin()
        || (signedIn()
          && request.auth.uid == userId
          && request.resource.data.email == resource.data.email
          && request.resource.data.globalRole == resource.data.globalRole
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['displayName', 'photoURL', 'lastLoginAt']));
      allow delete: if isGlobalAdmin() && resource.data.email != 'jaru072@gmail.com';
    }

    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(projectId);

      match /members/{userId} {
        allow get: if signedIn() && (request.auth.uid == userId || isAdmin(projectId));
        allow list: if isAdmin(projectId);
        allow create: if (isAdmin(projectId)
            && request.resource.data.role in ['admin', 'manager', 'user'])
          || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.email == request.auth.token.email
            && request.resource.data.role == (isDefaultAdmin() ? 'admin' : 'user'));
        allow update: if isAdmin(projectId)
          || (signedIn()
            && request.auth.uid == userId
            && request.resource.data.email == resource.data.email
            && request.resource.data.role == resource.data.role
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['displayName', 'lastLoginAt']));
        allow delete: if isAdmin(projectId) && resource.data.email != 'jaru072@gmail.com';
      }

      match /media/{mediaId} {
        allow read: if true;
        allow create: if isAdmin(projectId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.get('source', 'manual') != 'google-drive'
          && request.resource.data.section in ['story', 'criteria', 'process', 'milestones', 'muchalinda', 'videos']
          && request.resource.data.type in ['image', 'video']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.url is string;
        allow update: if isAdmin(projectId)
          && resource.data.get('source', 'manual') != 'google-drive'
          && request.resource.data.get('source', 'manual') != 'google-drive';
        allow delete: if isAdmin(projectId)
          && resource.data.get('source', 'manual') != 'google-drive';
      }

      match /settings/{settingId} {
        allow read: if true;
        allow write: if isAdmin(projectId);
      }

      // กล่องข้อมูลแถบขวา (Right Rail Cards)
      match /railCards/{cardId} {
        allow read: if true;
        allow create, update, delete: if isAdmin(projectId);
      }

      // ผังโครงการ: บุคคลทั่วไปอ่านได้เฉพาะหัวข้อที่เปิดเผยแพร่
      match /siteNodes/{nodeId} {
        allow read: if isAdmin(projectId) || resource.data.published == true;
        allow create, update, delete: if isAdmin(projectId);
      }

      // ข่าว/กิจกรรม เอกสาร และช่องทางร่วมบุญ
      match /content/{contentId} {
        allow read: if isAdmin(projectId) || resource.data.published == true;
        allow create: if isAdmin(projectId)
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.kind in ['news', 'document', 'donation']
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 160
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 5000
          && request.resource.data.published is bool
          && request.resource.data.imageUrl is string
          && request.resource.data.actionUrl is string;
        allow update, delete: if isAdmin(projectId);
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if signedIn()
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 1000;
        allow update: if false;
        allow delete: if isAdmin(projectId)
          || (signedIn() && resource.data.authorId == request.auth.uid);
      }

      match /chatThreads/{ownerId} {
        allow read: if signedIn() && (request.auth.uid == ownerId || isStaff(projectId));
        allow create: if signedIn()
          && request.auth.uid == ownerId
          && request.resource.data.ownerId == request.auth.uid;
        allow update: if signedIn()
          && (request.auth.uid == ownerId || isStaff(projectId))
          && request.resource.data.ownerId == resource.data.ownerId;
        allow delete: if isAdmin(projectId);

        match /messages/{messageId} {
          allow read: if signedIn() && (request.auth.uid == ownerId || isStaff(projectId));
          allow create: if signedIn()
            && (request.auth.uid == ownerId || isStaff(projectId))
            && request.resource.data.senderId == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() > 0
            && request.resource.data.text.size() <= 1000;
          allow update: if false;
          allow delete: if isAdmin(projectId);
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
